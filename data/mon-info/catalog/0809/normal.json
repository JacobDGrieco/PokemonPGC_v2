			"localizedFlavorByGame": {
				"legendszamd": {
					"en": "It was worshipped long ago for its capacity to produce iron. For some reason, it has come back to life after 3,000 years.",
					"fr": "Autrefois vénéré pour son aptitude à produire du fer, ce Pokémon a mystérieusement ressuscité après 3 000 ans.",
					"de": "Einst wurde es für seine Fähigkeit verehrt, Eisen erschaffen zu können. Nach 3000 Jahren ist es aus einem unerfindlichen Grund wieder erwacht.",
