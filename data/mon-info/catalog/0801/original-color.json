			"localizedFlavorByGame": {
				"legendszamd": {
					"en": "This Magearna looks as it did at the time of its invention. Its magnificent ornamentation delighted the king's daughter.",
					"fr": "Il a été créé par un scientifique il y a environ 500 ans de cela. Sa véritable essence est un organe nommé Animacœur.",
