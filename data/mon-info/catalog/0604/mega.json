			"flavorByGame": {
				"legendsza": "With their sucker mouths, they latch on to prey. Then they use their fangs to shock the prey with electricity."
			},
			"localizedFlavorByGame": {
				"legendsza": {
					"en": "With their sucker mouths, they latch on to prey. Then they use their fangs to shock the prey with electricity.",
					"fr": "Il s’attache à ses proies avec sa bouche-ventouse et les électrocute avec ses crocs.",
					"de": "Mit seinem Saugnapfmaul heftet es sich an seiner Beute fest und versetzt ihr über seine Fangzähne Stromschläge.",
					"it": "Si attacca alla preda con la bocca a ventosa e la fulmina attraverso i denti in essa conficcati.",
					"ja": "吸盤の 口で 獲物に 吸いつき 食いこませた キバから 電気を 流して 感電させる。",
					"ko": "흡반 같은 입으로 먹이에 달라붙은 후 박아 넣은 이빨을 통해 전기를 흘려 감전시킨다.",
					"es-419": "Se pega a su presa con la ventosa de su boca y luego la electrocuta al clavarle los colmillos.",
					"zh-hans": "用吸盘一样的嘴巴吸住猎物， 并从刺入的牙齿中释放电流， 使对方触电。",
					"es": "Pega la ventosa de su boca en su presa y la electrocuta al clavarle los colmillos.",
					"zh-hant": "用吸盤般的嘴吸住獵物， 並從刺入的牙齒釋放電流， 使獵物觸電。"
				}
			}
