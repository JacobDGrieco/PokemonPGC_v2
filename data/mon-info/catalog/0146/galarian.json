			"flavorByGame": {
				"sword": "It’s one of the legendary bird Pokémon. When Moltres flaps its flaming wings, they glimmer with a dazzling red glow.",
				"shield": "There are stories of this Pokémon using its radiant, flame-cloaked wings to light up paths for those lost in the mountains."
			},
			"localizedFlavorByGame": {
				"sword": {
					"ja-hrkt": "はばたくと つばさの ほのおが あかく うつくしく きらめく でんせつの とりポケモンの １ぴき。",
					"ko": "날갯짓을 하면 날개의 불꽃이 빨갛고 아름답게 빛나는 전설의 새포켓몬 중 1마리다.",
					"zh-hant": "每當牠拍動翅膀，羽毛就會 閃爍出美麗的赤紅火焰。 是傳說的鳥寶可夢之一。",
					"fr": "Il s’agit d’un des Pokémon oiseaux légendaires. Des flammes rouges d’une grande beauté étincellent lorsqu’il bat des ailes.",
					"de": "Schlägt dieses Legendäre Vogel-Pokémon mit den Flügeln, so leuchten die Flammen an seinen Schwingen in einem bezaubernden Rot.",
					"es": "Una de las aves legendarias. Al batir las alas, las llamas que las envuelven emiten un hermoso fulgor rojo.",
					"it": "Uno dei leggendari Pokémon alati. Quando sbatte le ali, le fiamme che le circondano brillano di uno splendido rosso acceso.",
					"en": "It’s one of the legendary bird Pokémon. When Moltres flaps its flaming wings, they glimmer with a dazzling red glow.",
					"ja": "羽ばたくと 翼の 炎が 赤く 美しく きらめく 伝説の 鳥ポケモンの １匹。",
					"zh-hans": "只要拍动翅膀，羽毛就会 闪现出红色的火焰，非常美丽。 传说的鸟宝可梦中的１只。",
					"es-419": "Una de las aves legendarias. Al batir las alas, las llamas que las envuelven emiten un hermoso fulgor rojo."
				},
				"shield": {
					"ja-hrkt": "うつくしく もえあがる つばさで やまみちを てらし そうなんしゃを たすけたと いいつたえられている。",
					"ko": "아름답게 타오르는 날개로 산길을 비춰 조난자를 도왔다고 전해져 오고 있다.",
					"zh-hant": "相傳牠會以美麗燃燒的 翅膀照亮山路，救助在 山中遇險的人。",
					"fr": "On raconte qu’il a sauvé des personnes perdues en montagne en illuminant les sentiers à l’aide de ses splendides ailes flamboyantes.",
					"de": "Überlieferungen nach soll Lavados mit seinen wunderschön lodernden Flügeln Bergpfade erleuchtet und dadurch Verirrten geholfen haben.",
					"es": "Se cuenta que alguna vez ha iluminado el camino con sus alas flamígeras para rescatar a alguien que se había perdido en la montaña.",
					"it": "Si narra che abbia aiutato dei viandanti che si erano persi illuminando i sentieri montuosi con le splendide ali infuocate.",
					"en": "There are stories of this Pokémon using its radiant, flame-cloaked wings to light up paths for those lost in the mountains.",
					"ja": "美しく 燃えあがる 翼で 山道を 照らし 遭難者を 助けたと 言い伝えられている。",
					"zh-hans": "相传它会用燃烧着的 美丽翅膀照亮山道， 救助在此遇险的人。",
					"es-419": "Se cuenta que alguna vez ha iluminado el camino con sus alas flamígeras para rescatar a alguien que se había perdido en la montaña."
				}
			}
		},
