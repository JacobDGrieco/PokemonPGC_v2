			"flavorByGame": {
				"legendszamd": "Chimecho create air vibrations with their cries to send foes flying. They have seven different types of cries they use to converse with one another."
			},
			"localizedFlavorByGame": {
				"legendszamd": {
					"en": "Chimecho create air vibrations with their cries to send foes flying. They have seven different types of cries they use to converse with one another.",
					"fr": "Ce Pokémon projette ses ennemis en faisant vibrer l’air avec sa voix. Il utilise sept sortes de cris pour communiquer avec ses congénères.",
					"de": "Indem es die Luft durch seine Schreie vibrieren lässt, weht es Gegner hinfort. Es kommuniziert mit Artgenossen über sieben verschiedene Schreie.",
					"it": "Spazza via i nemici con le vibrazioni dell’aria prodotte dai suoi urli. Comunica con i suoi simili tramite l’uso di sette versi differenti.",
					"ja": "鳴き声で 空気を 振動させ 相手を 吹き飛ばす。 ７種類の 声で 仲間と 会話する。",
					"ko": "울음소리로 공기를 진동시켜 상대를 날려 버린다. 7종류의 목소리로 동료와 대화한다.",
					"es-419": "Sus gritos sacuden el aire para que sus rivales salgan volando. Se comunican entre sí entonando siete tipos de gritos diferentes.",
					"zh-hans": "会用叫声振动空气， 来轰飞对手。使用７种 不同的声音和同伴说话。",
					"es": "Sus gritos sacuden el aire para que sus rivales salgan volando. Se comunican entre sí entonando siete tipos de gritos diferentes.",
					"zh-hant": "會用叫聲使空氣產生振動 來轟飛對手。使用７種 不同的聲音和夥伴交談。"
				}
			}
		}
