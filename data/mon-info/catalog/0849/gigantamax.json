			"flavorByGame": {
				"sword": "When this Pokémon sounds as if it’s strumming a guitar, it’s actually clawing at the protrusions on its chest to generate electricity.",
				"shield": "This short-tempered and aggressive Pokémon chugs stagnant water to absorb any toxins it might contain."
			},
			"localizedFlavorByGame": {
				"sword": {
					"ja-hrkt": "むねの とっきを かきむしり でんきを おこすとき あたりに ギターのような おとが ひびく。",
					"ko": "가슴에 난 돌기를 긁으면 전기가 일어나며 주위에 기타와 비슷한 소리가 울려퍼진다.",
					"zh-hant": "當牠用力抓撓胸部的突起物 來製造電力時，四周會響起 如同吉他演奏般的聲音。",
					"fr": "Lorsqu’il gratte l’excroissance sur son ventre pour produire de l’électricité, on peut entendre un son similaire à celui d’une guitare.",
					"de": "Wenn es am Fortsatz an seiner Brust kratzt und dadurch Strom erzeugt, dann erklingt in der Umgebung ein Ton wie von einer Gitarre.",
					"es": "Cuando rasga las protuberancias del pecho para generar energía eléctrica, emite un sonido similar al de una guitarra, que reverbera en el entorno.",
					"it": "Quando produce energia elettrica strofinando le protuberanze che ha sul petto, tutt’intorno riverbera un suono simile a quello di una chitarra.",
					"en": "When this Pokémon sounds as if it’s strumming a guitar, it’s actually clawing at the protrusions on its chest to generate electricity.",
					"ja": "胸の 突起を 掻きむしり 電気を 起こすとき あたりに ギターのような 音が 響く。",
					"zh-hans": "当它用力抓挠胸部的突起物 来制造电力时，四周会响起 如同吉他演奏般的声音。",
					"es-419": "Cuando rasga las protuberancias del pecho para generar energía eléctrica, emite un sonido similar al de una guitarra, que reverbera en el entorno."
				},
				"shield": {
					"ja-hrkt": "ケンカごしで きが みじかい。 よどんだ みずを ガブのみして すいちゅうの どくそを とりこむ。",
					"ko": "호전적이며 성미가 급하다. 고인 물을 벌컥벌컥 마셔서 물속의 독소를 흡수한다.",
					"zh-hant": "氣勢洶洶的急性子。 會大口喝下混濁的水， 吸收其中所含的毒素。",
					"fr": "Impatient et bagarreur, ce Pokémon avale de grandes gorgées d’eau croupie pour en absorber toute la toxicité.",
					"de": "Dieses streitsüchtige und leicht reizbare Pokémon kippt abgestandenes Wasser in sich hinein und nimmt die darin enthaltenen Giftstoffe in sich auf.",
					"es": "Posee un carácter belicoso e irascible. Bebe una gran cantidad de agua estancada para absorber sus toxinas.",
					"it": "È litigioso e irascibile. Ingurgita acqua stagnante in grandi quantità per assorbire le tossine in essa contenute.",
					"en": "This short-tempered and aggressive Pokémon chugs stagnant water to absorb any toxins it might contain.",
					"ja": "ケンカ腰で 気が 短い。 よどんだ 水を がぶ飲みして 水中の 毒素を 取りこむ。",
					"zh-hans": "气势汹汹的急性子。 会大口喝下浑浊的水， 吸收其中所含的毒素。",
					"es-419": "Posee un carácter belicoso e irascible. Bebe una gran cantidad de agua estancada para absorber sus toxinas."
				}
			}
