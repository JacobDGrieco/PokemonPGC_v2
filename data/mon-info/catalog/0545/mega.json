			"flavorByGame": {
				"legendsza": "It clasps its prey with the claws on its neck until they stop moving. Then it finishes them off with deadly venom."
			},
			"localizedFlavorByGame": {
				"legendsza": {
					"en": "It clasps its prey with the claws on its neck until they stop moving. Then it finishes them off with deadly venom.",
					"fr": "Il immobilise ses proies avec les griffes de son cou avant de les achever grâce à son poison virulent.",
					"de": "Es klemmt seine Beute zwischen den Krallen an seinem Hals ein und macht sie bewegungsunfähig. Mit einer Ladung Gift gibt es ihr den Rest.",
					"it": "Trafigge la preda con gli artigli del collo e dopo averla immobilizzata la finisce con le sue tossine.",
					"ja": "獲物を 首のツメで 挟みこみ 身動きを とれなくしてから 猛毒を 与え とどめを 刺す。",
					"ko": "먹이를 목의 가시에 끼워 넣어 움직이지 못하게 한 후 맹독을 퍼뜨려 마무리한다.",
					"es-419": "Sujeta a sus presas con las garras que le sobresalen del cuello hasta inmovilizarlas y luego las remata con veneno.",
					"zh-hans": "用颈部的爪子夹住猎物， 让对方动弹不得之后， 施以剧毒，一击毙命。",
					"es": "Atenaza a sus presas con las garras que le sobresalen del cuello hasta que no se pueden mover y las remata con veneno.",
					"zh-hant": "用頸部的爪子夾住獵物， 使其動彈不得後， 注入劇毒給予致命一擊。"
				}
			}
