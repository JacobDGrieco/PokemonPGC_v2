# Database (server-only)
DB_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DB_DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Authentication and canonical browser origin (server-only)
AUTH_SECRET="replace-with-at-least-32-random-bytes"
APP_ORIGIN="http://localhost:5173"

# SMTP authentication email (server-only)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_REQUIRE_TLS="true"
SMTP_USER="smtp-user@example.com"
SMTP_PASS="replace-me"
SMTP_FROM_EMAIL="no-reply@example.com"
SMTP_FROM_NAME="PokemonPGC"

# Stripe (server-only)
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_PORTAL_CONFIGURATION_ID="bpc_replace_me"
STRIPE_PRICE_GREAT="price_replace_me"
STRIPE_PRICE_ULTRA="price_replace_me"
STRIPE_PRICE_MASTER="price_replace_me"

# PayPal (server-only)
PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_CLIENT_ID="replace-me"
PAYPAL_CLIENT_SECRET="replace-me"
PAYPAL_WEBHOOK_ID="replace-me"
PAYPAL_PLAN_GREAT="P-replace-me"
PAYPAL_PLAN_ULTRA="P-replace-me"
PAYPAL_PLAN_MASTER="P-replace-me"

# Runtime client configuration. VITE_* takes precedence during the build.
VITE_API_BASE_URL=""
VITE_ASSET_BASE_URL=""
API_BASE_URL=""
ASSET_BASE_URL=""

# Local API adapter (optional; defaults to 3000)
PPGC_API_PORT="3000"

# Cloudflare R2 asset uploader (operations only)
R2_ACCOUNT_ID="replace-me"
R2_ACCESS_KEY_ID="replace-me"
R2_SECRET_ACCESS_KEY="replace-me"
R2_BUCKET_NAME="replace-me"

# Optional GitHub API token used only by the event scraper
GITHUB_TOKEN=""
