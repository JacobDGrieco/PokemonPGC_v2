{
	"name": "pokemonpgc",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "concurrently --names \"api\" --prefix-colors \"cyan,yellow\" \"npm run dev:client\" \"npm run dev:api\"",
		"dev:client": "vite",
		"dev:api": "node ./scripts/api-dev-server.mjs",
		"build": "vite build && node ./scripts/write-dist-env.mjs && node ./scripts/check-performance-budgets.mjs",
		"performance:check": "node ./scripts/check-performance-budgets.mjs",
		"docs:check": "node ./scripts/check-documentation.mjs",
		"preview": "vite preview",
		"test": "node --test",
		"postinstall": "npx prisma generate --schema prisma/schema.prisma",
		"db:push": "npx prisma db push --schema prisma/schema.prisma",
		"deploy:prepare-db": "npx prisma generate --schema prisma/schema.prisma && npx prisma db push --schema prisma/schema.prisma",
		"prisma:push": "prisma db push --schema prisma/schema.prisma",
		"prisma:generate": "prisma generate --schema prisma/schema.prisma",
		"prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
		"prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
		"stripe:audit": "node ./scripts/audit-stripe.mjs",
		"stripe:test-plan-lifecycle": "node ./scripts/stripe-plan-lifecycle.mjs",
		"admin:tier-access": "node ./scripts/admin-tier-access.mjs",
		"test-accounts:create": "node ./scripts/create-test-accounts.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint:js": "eslint .",
		"lint:css": "stylelint \"styles/**/*.css\" \"src/**/*.css\"",
		"lint": "npm run lint:js && npm run lint:css",
		"check": "npm run format:check && npm run lint && npm run docs:check && npm test && npm run build"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1006.0",
		"@neondatabase/serverless": "^1.0.2",
		"@prisma/adapter-pg": "7.10.1",
		"@prisma/client": "7.10.1",
		"@vercel/analytics": "^2.0.1",
		"bcryptjs": "^2.4.3",
		"canvas-confetti": "^1.9.4",
		"dotenv": "^17.3.1",
		"motion": "^12.38.0",
		"nodemailer": "^10.1.7",
		"primeicons": "^7.0.0",
		"pg": "8.23.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-icons": "^5.6.0",
		"react-router-dom": "^7.14.1",
		"stripe": "^22.0.2",
		"three": "^0.182.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@vitejs/plugin-react": "^4.7.0",
		"concurrently": "^9.2.1",
		"eslint": "^9.39.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prisma": "7.10.1",
		"stylelint": "^17.16.0",
		"vite": "^7.1.7"
	}
}
