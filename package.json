{
	"name": "pokemonpgc",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "20.x"
	},
	"scripts": {
		"dev": "concurrently --names \"api\" --prefix-colors \"cyan,yellow\" \"npm run dev:client\" \"npm run dev:api\"",
		"dev:client": "vite",
		"dev:api": "node ./scripts/api-dev-server.mjs",
		"build": "vite build && node ./scripts/write-dist-env.mjs",
		"preview": "vite preview",
		"test": "node --test",
		"postinstall": "npx prisma generate --schema prisma/schema.prisma",
		"db:push": "npx prisma db push --schema prisma/schema.prisma",
		"deploy:prepare-db": "npx prisma generate --schema prisma/schema.prisma && npx prisma db push --schema prisma/schema.prisma",
		"prisma:push": "prisma db push --schema prisma/schema.prisma",
		"prisma:generate": "prisma generate --schema prisma/schema.prisma",
		"prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
		"prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
		"test-accounts:create": "node ./scripts/create-test-accounts.mjs"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1006.0",
		"@neondatabase/serverless": "^1.0.2",
		"@prisma/client": "^6.19.0",
		"@vercel/analytics": "^2.0.1",
		"bcryptjs": "^2.4.3",
		"canvas-confetti": "^1.9.4",
		"dotenv": "^17.3.1",
		"motion": "^12.38.0",
		"nodemailer": "^10.1.7",
		"primeicons": "^7.0.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-icons": "^5.6.0",
		"react-router-dom": "^7.14.1",
		"stripe": "^22.0.2",
		"three": "^0.182.0"
	},
	"devDependencies": {
		"@vitejs/plugin-react": "^4.7.0",
		"concurrently": "^9.2.1",
		"prisma": "^6.19.0",
		"vite": "^7.1.7"
	}
}
