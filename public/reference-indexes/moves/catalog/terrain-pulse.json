	"effectEntries": [
		{
			"language": "en",
			"effect": "If any terrain is active and the user is grounded, this moves power is doubled and changes type to match that terrains type.",
			"shortEffect": "If any terrain is active and the user is grounded, this moves power is doubled and changes type to match that terrains type."
		}
	],
	"effectChanges": [],
	"descriptions": [
		{
			"versionGroup": "legends-arceus",
			"language": "en",
			"text": "The user utilizes the power of the terrain to attack. This move's type and power changes depending on the terrain when it's used."
		},
		{
			"versionGroup": "scarlet-violet",
			"language": "en",
			"text": "The user utilizes the energy of the terrain to attack. This move’s type and power change depending on the terrain at the time the move is used."
		},
		{
			"versionGroup": "sword-shield",
			"language": "de",
			"text": "Der Anwender nutzt die Kraft des aktiven Feldes für seinen Angriff. Der Typ und die Stärke der Attacke ändern sich je nach Art des aktiven Feldes."
		},
		{
			"versionGroup": "sword-shield",
			"language": "en",
			"text": "The user utilizes the power of the terrain to attack. This move’s type and power changes depending on the terrain when it’s used."
		},
		{
			"versionGroup": "sword-shield",
			"language": "es",
			"text": "El usuario ataca aprovechando la energía del campo activo, que determina tanto el tipo como la potencia del movimiento."
		},
		{
			"versionGroup": "sword-shield",
			"language": "es-419",
			"text": "El usuario ataca aprovechando la energía del campo activo, que determina tanto el tipo como la potencia del movimiento."
		},
		{
			"versionGroup": "sword-shield",
			"language": "fr",
			"text": "Une attaque qui tire sa force des champs. Son type et sa puissance varient selon le champ actif."
		},
		{
			"versionGroup": "sword-shield",
			"language": "it",
			"text": "Chi la usa attacca sfruttando l’energia del terreno di lotta. Il tipo e la potenza della mossa variano a seconda dello stato del terreno stesso."
		},
		{
			"versionGroup": "sword-shield",
			"language": "ja",
			"text": "フィールドの力を 借りて 攻撃。 使った時の フィールドの状態に よって 技の タイプと 威力が 変わる。"
		},
		{
			"versionGroup": "sword-shield",
			"language": "ja-hrkt",
			"text": "フィールドの ちからを かりて こうげき。 つかったときの フィールドのじょうたいに よって わざの タイプと いりょくが かわる。"
		},
		{
			"versionGroup": "sword-shield",
			"language": "ko",
			"text": "필드의 힘을 빌려서 공격한다. 사용했을 때의 필드 상태에 따라서 기술 타입과 위력이 바뀐다."
		},
		{
			"versionGroup": "sword-shield",
			"language": "zh-hans",
			"text": "借助场地的力量进行攻击。 视使出招式时场地状态不同， 招式的属性和威力会有所变化。"
		},
		{
			"versionGroup": "sword-shield",
			"language": "zh-hant",
			"text": "藉助場地的力量進行攻擊。 視使出招式時場地狀態不同， 招式的屬性和威力會有所變化。"
		}
