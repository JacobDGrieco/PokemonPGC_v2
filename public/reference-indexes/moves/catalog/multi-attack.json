	"effectEntries": [
		{
			"language": "en",
			"effect": "Inflicts regular damage. If the user is holding a plate or a drive, this move’s type is the type corresponding to that item. Note: This effect is technically shared by both Techno Blast and Judgment; however, Techno Blast is only affected by drives, and Judgment is only affected by plates.",
			"shortEffect": "If the user is holding a appropriate plate or drive, the damage inflicted will match it."
		},
		{
			"language": "fr",
			"effect": "Inflige des dégâts réguliers. Si le lanceur porte une plaque ou un module, le type de cette capacité est le type correspondant à cet objet.",
			"shortEffect": "Si le lanceur tient une plaque ou module approprié, les dégâts infligés y correspondent."
		}
	],
	"effectChanges": [],
	"descriptions": [
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "de",
			"text": "Der Anwender sammelt eine große Menge Energie und greift das Ziel damit an. Der Typ der Attacke hängt von dem der Disc ab."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "en",
			"text": "Cloaking itself in high energy, the user slams into the target. The memory held determines the move’s type."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "es",
			"text": "El Pokémon se rodea de una potente energía con la que golpea al rival. El tipo del movimiento depende del disco que lleva el usuario."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "es-419",
			"text": "El Pokémon se rodea de una potente energía con la que golpea al rival. El tipo del movimiento depende del disco que lleva el usuario."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "fr",
			"text": "Le Pokémon s’entoure d’une puissante énergie avant de foncer sur sa cible. Le type de la capacité dépend de la ROM installée."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "it",
			"text": "Chi la usa si avvolge in un potente campo energetico e colpisce il bersaglio. Il tipo della mossa varia in base alla ROM installata."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "ja",
			"text": "高い エネルギーを まといつつ 相手に ぶつかって 攻撃する。 メモリに より タイプが 変わる。"
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "ja-hrkt",
			"text": "たかい エネルギーを まといつつ あいてに ぶつかって こうげきする。 メモリに より タイプが かわる。"
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "ko",
			"text": "높은 에너지를 둘러싸 상대에게 부딪쳐 공격한다. 메모리에 따라 타입이 바뀐다."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "zh-hans",
			"text": "一边覆盖高能量， 一边撞向对手进行攻击。 根据存储碟不同，属性会改变。"
