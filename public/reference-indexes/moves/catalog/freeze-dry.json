	"effectEntries": [
		{
			"language": "en",
			"effect": "Inflicts regular damage. This move is super-effective against the Water type. The target’s other type will affect damage as usual. If this move’s type is changed, it remains super-effective against Water regardless of its type.",
			"shortEffect": "Super-effective against Water."
		},
		{
			"language": "fr",
			"effect": "Inflige des dégâts réguliers. Cette capacité est super efficace contre le type Eau. Les autres types de la cible affectent les dégâts normalement. Si le type de cette capacité est changé, elle reste super effiicace contre l'Eau peu importe son type.",
			"shortEffect": "Super-efficace contre Eau."
		}
	],
	"effectChanges": [],
	"descriptions": [
		{
			"versionGroup": "legends-arceus",
			"language": "en",
			"text": "The user rapidly cools the target. This may also leave the target frozen. This move is super effective on Water types."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "de",
			"text": "Das Ziel wird stark abgekühlt und manchmal sogar eingefroren. Die Attacke ist sehr effektiv gegen Wasser-Pokémon."
