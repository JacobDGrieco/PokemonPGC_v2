	"descriptions": [
		{
			"versionGroup": "legends-arceus",
			"language": "en",
			"text": "In this two-turn attack, the user gathers light and fills a blade with the light's energy, attacking the target on the next turn."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "de",
			"text": "Der Anwender absorbiert in der 1. Runde Licht, das er in der 2. Runde zu einem Schwert formt, mit dem er angreift."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
