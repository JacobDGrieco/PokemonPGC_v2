	"descriptions": [
		{
			"versionGroup": "legends-arceus",
			"language": "en",
			"text": "The user attacks the target by controlling the target's item. The move fails if the target doesn't have an item."
		},
		{
			"versionGroup": "scarlet-violet",
			"language": "en",
			"text": "The user attacks by controlling the target's item. This move fails if the target isn't holding an item."
		},
		{
			"versionGroup": "sword-shield",
			"language": "de",
			"text": "Der Anwender greift das Ziel mit dessen getragenem Item an. Die Attacke schlägt fehl, wenn das Ziel kein Item trägt."
		},
		{
			"versionGroup": "sword-shield",
			"language": "en",
			"text": "The user attacks the target by controlling the target’s item. The move fails if the target doesn’t have an item."
		},
		{
			"versionGroup": "sword-shield",
			"language": "es",
			"text": "El usuario ataca utilizando el objeto que lleva el rival. Si no tiene ninguno equipado, el movimiento falla."
		},
		{
			"versionGroup": "sword-shield",
			"language": "es-419",
			"text": "El usuario ataca utilizando el objeto que lleva el rival. Si no tiene ninguno equipado, el movimiento falla."
		},
		{
			"versionGroup": "sword-shield",
			"language": "fr",
			"text": "Le lanceur manipule l’objet tenu par l’ennemi pour l’attaquer. Échoue si la cible ne tient rien."
		},
		{
			"versionGroup": "sword-shield",
			"language": "it",
			"text": "Chi la usa attacca utilizzando lo strumento del bersaglio. La mossa fallisce se quest’ultimo non ha uno strumento."
		},
		{
			"versionGroup": "sword-shield",
			"language": "ja",
			"text": "相手の 持ち物を あやつって 攻撃。 相手が 道具を 持っていない 場合は 失敗する。"
		},
		{
			"versionGroup": "sword-shield",
			"language": "ja-hrkt",
			"text": "あいての もちものを あやつって こうげき。 あいてが どうぐを もっていない ばあいは しっぱい する。"
		},
		{
			"versionGroup": "sword-shield",
			"language": "ko",
			"text": "상대의 지닌 물건을 조종해서 공격한다. 상대가 도구를 지니고 있지 않으면 실패한다."
		},
		{
			"versionGroup": "sword-shield",
			"language": "zh-hans",
			"text": "操纵对手的持有物进行攻击。 当对手没有携带道具时， 使出此招式时便会失败。"
		},
		{
			"versionGroup": "sword-shield",
			"language": "zh-hant",
			"text": "操控對手的持有物進行攻擊。 對手沒有攜帶道具時， 則會失敗。"
		}
