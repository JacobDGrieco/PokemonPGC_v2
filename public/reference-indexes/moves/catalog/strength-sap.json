	"effectEntries": [
		{
			"language": "en",
			"effect": "Lowers the target’s Attack by one stage. Heals the user by the target’s current Attack, including modifiers, but not including this move’s Attack-lowering effect. If the target’s Attack is already at -6, this move will fail. In any other situation that would prevent a stat modification, the healing will still succeed.",
			"shortEffect": "Heals the user by the target’s current Attack stat and lowers the target’s Attack by one stage."
		},
		{
			"language": "fr",
			"effect": "Diminue l'Attaque de la cible d'un niveau. Soigne le lanceur de l'Attaque actuelle de la cible, incluant les modifications, mais n'incluant pas l'effet de baisse d'Attaque de cette capacité. Si l'Attaque de la cible est déjà à -6, cette capacité échouera. Dans n'importe quelle autre situation qui empêcherait une modification de stat, le soin restera un succès.",
			"shortEffect": "Soigne le lanceur de la stat d'Attaque actuelle de la cible et diminue l'Attaque de la cible d'un niveau."
		}
	],
	"effectChanges": [],
	"descriptions": [
		{
			"versionGroup": "legends-arceus",
			"language": "en",
			"text": "The user restores its HP by the same amount as the target's Attack stat. It also lowers the target's Attack stat."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "de",
			"text": "Ein Angriff, der die KP des Anwenders um die Höhe des Angriffs-Werts des Zieles heilt. Anschließend wird der Angriff des Zieles gesenkt."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "en",
			"text": "The user restores its HP by the same amount as the target’s Attack stat. It also lowers the target’s Attack stat."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "es",
			"text": "Restaura una cantidad de PS equivalente al valor de Ataque del rival, que además verá reducida esta característica."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "es-419",
			"text": "Restaura una cantidad de PS equivalente al valor de Ataque del rival, que además verá reducida esta característica."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "fr",
			"text": "Rend au lanceur une quantité de PV équivalente à la stat d’Attaque de la cible, puis baisse celle-ci."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "it",
			"text": "Fa recuperare una quantità di PS pari all’Attacco del bersaglio, che vedrà diminuire questa statistica."
