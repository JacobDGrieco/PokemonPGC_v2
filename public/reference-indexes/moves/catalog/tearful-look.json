	"descriptions": [
		{
			"versionGroup": "legends-arceus",
			"language": "en",
			"text": "The user gets teary eyed to make the target lose its combative spirit. This lowers the target's Attack and Sp. Atk stats."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "de",
			"text": "Dem Anwender stehen Tränen in den Augen, wodurch das Ziel seinen Kampfeswillen verliert. Angriff und Spezial-Angriff des Zieles sinken."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "en",
			"text": "The user gets teary eyed to make the target lose its combative spirit. This lowers the target’s Attack and Sp. Atk stats."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "es",
			"text": "Mira al objetivo con ojos llorosos para hacerle perder su espíritu combativo y reduce su Ataque y Ataque Especial."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "es-419",
			"text": "Mira al objetivo con ojos llorosos para hacerle perder su espíritu combativo y reduce su Ataque y Ataque Especial."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "fr",
			"text": "Le lanceur jette un regard plein de larmes à la cible. Celle-ci perd toute velléité de combat et voit son Attaque et son Attaque Spéciale baisser."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "it",
			"text": "Chi la usa guarda il bersaglio con gli occhi pieni di lacrime e gli fa perdere lo spirito combattivo, riducendone l’Attacco e l’Attacco Speciale."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "ja",
			"text": "なみだめに なって 相手の 戦力を 喪失させる。 相手の 攻撃と 特攻が さがる。"
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "ja-hrkt",
			"text": "なみだめに なって あいての せんりょくを そうしつさせる。 あいての こうげきと とくこうが さがる。"
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "ko",
