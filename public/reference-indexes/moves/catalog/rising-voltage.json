	"descriptions": [
		{
			"versionGroup": "legends-arceus",
			"language": "en",
			"text": "The user attacks with electric voltage rising from the ground. This move's power doubles when the target is on Electric Terrain."
		},
		{
			"versionGroup": "scarlet-violet",
			"language": "en",
			"text": "The user attacks with electricity rising from the ground. This move's power is doubled if the target is on Electric Terrain."
		},
		{
			"versionGroup": "sword-shield",
			"language": "de",
			"text": "Der Anwender greift mit aus dem Boden aufsteigender Elektrizität an. Die Stärke der Attacke wird verdoppelt, wenn beim Gegner ein Elektrofeld aktiv ist."
		},
		{
			"versionGroup": "sword-shield",
			"language": "en",
			"text": "The user attacks with electric voltage rising from the ground. This move’s power doubles when the target is on Electric Terrain."
		},
		{
			"versionGroup": "sword-shield",
			"language": "es",
			"text": "Ataca con una descarga eléctrica que surge del terreno de combate. La potencia del movimiento se duplica si el rival se ve afectado por un campo eléctrico."
		},
		{
			"versionGroup": "sword-shield",
			"language": "es-419",
			"text": "Ataca con una descarga eléctrica que surge del terreno de combate. La potencia del movimiento se duplica si el rival se ve afectado por un campo eléctrico."
		},
		{
			"versionGroup": "sword-shield",
			"language": "fr",
			"text": "Des éclairs surgissent du sol et frappent l’ennemi. La puissance de cette attaque est doublée si la cible est sur un Champ Électrifié."
		},
		{
			"versionGroup": "sword-shield",
			"language": "it",
			"text": "Chi la usa attacca con dell’elettricità che si alza dal suolo. La potenza della mossa raddoppia quando l’avversario si trova in un Campo Elettrico."
		},
		{
			"versionGroup": "sword-shield",
			"language": "ja",
			"text": "地面から 立ちのぼる 電撃で 攻撃。 相手が エレキフィールドに いる時 技の 威力が ２倍に なる。"
		},
		{
			"versionGroup": "sword-shield",
			"language": "ja-hrkt",
			"text": "じめんから たちのぼる でんげきで こうげき。 あいてが エレキフィールドに いるとき わざの いりょくが ２ばいに なる。"
		},
		{
			"versionGroup": "sword-shield",
			"language": "ko",
			"text": "지면에서 올라오는 전격으로 공격한다. 상대가 일렉트릭필드 위에 있을 때 기술의 위력이 2배가 된다."
		},
		{
			"versionGroup": "sword-shield",
			"language": "zh-hans",
			"text": "用从地面升腾而起的电击进行攻击。 当对手处于电气场地上时， 招式威力会变成２倍。"
		},
		{
			"versionGroup": "sword-shield",
			"language": "zh-hant",
			"text": "用從地面升騰的電擊攻擊。 當對手在電氣場地時， 招式威力會變成２倍。"
		}
