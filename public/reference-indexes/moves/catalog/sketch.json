	"effectEntries": [
		{
			"language": "en",
			"effect": "Permanently replaces itself with the target’s last used move. If that move is Chatter or Struggle, this move will fail. This move cannot be copied by Mimic or Mirror Move, nor selected by Assist or Metronome, nor forced by Encore.",
			"shortEffect": "Permanently becomes the target’s last used move."
		},
		{
			"language": "fr",
			"effect": "Remplace par la dernière capacité que la cible a utilisé de manière permanente. Si cette capacité est Babil ou Lutte, cette capacité échouera. Cette capacité ne peut pas être copiée par Copie ou Mimique, ni sélectionnée par Assistance ou Métronome, ni forcée par Encore.",
			"shortEffect": "Devient définitivement la dernière capacité utilisée par la cible."
		}
	],
