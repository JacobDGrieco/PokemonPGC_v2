	"effectEntries": [
		{
			"language": "en",
			"effect": "Inflicts regular damage. Hits three times in the same turn. The second hit has double power, and the third hit has triple power. Each hit has a separate accuracy check, and this move stops if a hit misses. Skill Link does not apply.",
			"shortEffect": "Hits three times, increasing power by 100% with each successful hit."
		},
		{
			"language": "fr",
			"effect": "Inflige des dégâts réguliers. Touche trois fois dans le même tour. Le second coup a une puissance double, et le troisième a une puissance triple. Chaque coup a une vérification de précision différente, et cette capacité s'arrête si un coup manque sa cible. Multi-Coups ne s'applique pas.",
			"shortEffect": "Touche trois fois, augmentant la puissance de 100% à chaque coup réussi."
		}
	],
