	"effectChanges": [],
	"descriptions": [
		{
			"versionGroup": "legends-arceus",
			"language": "en",
			"text": "The user attacks while destroying the terrain. This move fails when the ground hasn't turned into a terrain."
		},
		{
			"versionGroup": "scarlet-violet",
			"language": "en",
			"text": "The user attacks while destroying the terrain. This move fails if the ground hasn't turned into a terrain."
		},
		{
			"versionGroup": "sword-shield",
			"language": "de",
			"text": "Der Anwender greift an und zerstört dabei etwaige Felder. Ist kein Feld aktiv, schlägt die Attacke fehl."
		},
		{
			"versionGroup": "sword-shield",
			"language": "en",
			"text": "The user attacks while destroying the terrain. This move fails when the ground hasn’t turned into a terrain."
		},
		{
			"versionGroup": "sword-shield",
			"language": "es",
			"text": "El usuario lanza su ataque y destruye el campo activo en el terreno de combate, y falla si no hay ninguno en ese momento."
		},
		{
			"versionGroup": "sword-shield",
			"language": "es-419",
			"text": "El usuario lanza su ataque y destruye el campo activo en el terreno de combate, y falla si no hay ninguno en ese momento."
		},
		{
			"versionGroup": "sword-shield",
			"language": "fr",
			"text": "Une attaque qui inflige des dégâts et fait disparaître le champ actif, mais qui échoue s’il n’y en a pas à ce moment."
		},
		{
			"versionGroup": "sword-shield",
			"language": "it",
			"text": "Chi la usa attacca eliminando lo stato del terreno di lotta. La mossa fallisce se nel terreno non è attivo alcuno stato."
		},
		{
			"versionGroup": "sword-shield",
			"language": "ja",
			"text": "フィールドを 破壊しながら 攻撃。 なんらかの フィールド状態に 変わっていないと 技は 失敗する。"
		},
		{
			"versionGroup": "sword-shield",
			"language": "ja-hrkt",
			"text": "フィールドを はかい しながら こうげき。 なんらかの フィールドじょうたいに かわって いないと わざは しっぱいする。"
		},
		{
			"versionGroup": "sword-shield",
			"language": "ko",
			"text": "필드를 파괴하면서 공격한다. 필드가 어떤 상태로든 변해 있지 않은 경우 기술은 실패한다."
		},
		{
			"versionGroup": "sword-shield",
			"language": "zh-hans",
			"text": "在破坏场地的同时攻击对手。 如果脚下没有任何场地状态存在， 使出此招式时便会失败。"
		},
		{
			"versionGroup": "sword-shield",
			"language": "zh-hant",
			"text": "一邊破壞場地，一邊進行攻擊。 在不是特殊狀態的場地上使用， 招式就會失敗。"
		}
