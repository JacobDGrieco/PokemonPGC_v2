	"effectEntries": [
		{
			"language": "en",
			"effect": "If this Pokémon is in its Disguised Form and takes damage from a move, it switches to its Busted Form and the damage is prevented. Other effects are not prevented. This ability cannot be copied or replaced. This ability only takes effect for Mimikyu.",
			"shortEffect": "Prevents the first instance of battle damage."
		},
		{
			"language": "fr",
			"effect": "Si ce Pokémon est dans sa Forme Déguisée et subit des dégâts d'une capacité, il change en sa Forme Démasquée et les dégâts sont annulés. Les autres effets ne sont pas empêchés. Ce talent ne peut pas être copié ou remplacé. Ce talent s'active seulement pour Mimiqui.",
			"shortEffect": "Évite les premiers dégâts de combat qu’il doit subir."
		}
	],
