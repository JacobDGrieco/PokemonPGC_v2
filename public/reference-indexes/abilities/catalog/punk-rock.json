	"descriptions": [
		{
			"versionGroup": "scarlet-violet",
			"language": "en",
			"text": "Boosts the power of sound-based moves. The Pokémon also takes half the damage from these kinds of moves."
		},
		{
			"versionGroup": "scarlet-violet",
			"language": "fr",
			"text": "Augmente la puissance des capacités basées sur le son.\\nLe Pokémon ne subit que la moitié des dégâts quand\\nil est touché par ce genre de capacités."
		},
		{
			"versionGroup": "sword-shield",
			"language": "de",
			"text": "Erhöht die Stärke von eigenen Lärm-Attacken und halbiert den Schaden, den das Pokémon selbst durch Lärm-Attacken erleidet."
		},
		{
			"versionGroup": "sword-shield",
			"language": "en",
			"text": "Boosts the power of sound-based moves. The Pokémon also takes half the damage from these kinds of moves."
		},
		{
			"versionGroup": "sword-shield",
			"language": "es",
			"text": "Potencia los movimientos que usan sonido y reduce a la mitad el daño que le infligen dichos movimientos."
		},
		{
			"versionGroup": "sword-shield",
			"language": "es-419",
			"text": "Potencia los movimientos que usan sonido y reduce a la mitad el daño que le infligen dichos movimientos."
		},
		{
			"versionGroup": "sword-shield",
			"language": "fr",
			"text": "Augmente la puissance des capacités basées sur le son. Le Pokémon ne subit que la moitié des dégâts quand il est touché par ce genre de capacités."
		},
		{
			"versionGroup": "sword-shield",
			"language": "it",
			"text": "Aumenta la potenza delle mosse basate sul suono. Inoltre, dimezza i danni subiti dal Pokémon se viene colpito da tali mosse."
		},
		{
			"versionGroup": "sword-shield",
			"language": "ja",
			"text": "音技の 威力が 上がる。 受けた 音技の ダメージは 半分に なる。"
		},
		{
			"versionGroup": "sword-shield",
			"language": "ja-hrkt",
			"text": "おとわざの いりょくが あがる。 うけた おとわざの ダメージは はんぶんに なる。"
		},
		{
			"versionGroup": "sword-shield",
			"language": "ko",
			"text": "소리 기술의 위력이 올라간다. 상대로부터 받는 소리 기술의 데미지는 절반이 된다."
		},
		{
			"versionGroup": "sword-shield",
