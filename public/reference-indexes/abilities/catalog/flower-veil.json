	"effectEntries": [
		{
			"language": "de",
			"effect": "Pflanze Pokémon können durch Gegner keine negativen Statusveränderung erleiden, solange sich ein Pokémon mit dieser Fähigkeit im Team befindet. Das betrifft nur direkte Statuswerteänderungenen, der Initiative Malus von Paralyse wird nicht verhindert, genauso wie selbstverursachte Statuswerteänderungenen wie z.B. durch Blättersturm.",
			"shortEffect": "Beschützt verbündete Pflanze Pokémon for negativen Statuswerteänderungenen."
		},
		{
			"language": "en",
			"effect": "Protects friendly Grass Pokémon from having their stats lowered by other Pokémon.",
			"shortEffect": "Protects friendly Grass Pokémon from having their stats lowered by other Pokémon."
		},
		{
			"language": "fr",
			"effect": "Protège les Pokémon alliés Plante sont immunisés aux baisses de stat causées par des capacités ou talents adverses. Immunise également contre les altérations majeures de statut.",
			"shortEffect": "Protège les Pokémon Plante alliés d'avoir leurs stats baissées par d'autres Pokémon."
		}
	],
	"effectChanges": [],
	"descriptions": [
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "de",
			"text": "Schützt Mitstreiter vom Typ Pflanze vor dem Senken ihrer Statuswerte sowie vor Statusproblemen."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "en",
			"text": "Ally Grass-type Pokémon are protected from status conditions and the lowering of their stats."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
