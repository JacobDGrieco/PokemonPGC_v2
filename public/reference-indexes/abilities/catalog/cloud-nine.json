	"effectEntries": [
		{
			"language": "de",
			"effect": "Während ein Pokémon mit dieser Fähigkeit im Kampf ist, kann das Wetter zwar geändert werden, hat aber keinen Effekt. Diese Fähigkeit ist identisch mit Klimaschutz.",
			"shortEffect": "Entfernt alle Wettereffekte aber ändert nicht das Wetter selbst."
		},
		{
			"language": "en",
			"effect": "While this Pokémon is in battle, weather can still be in play, but will not have any of its effects. This ability functions identically to Air Lock.",
			"shortEffect": "Negates all effects of weather, but does not prevent the weather itself."
		},
		{
			"language": "fr",
			"effect": "Quand ce Pokémon est au combat, la météo reste en jeu, mais n'a aucun de ses effets. Ce talent fonctionne de la même manière que Air Lock.",
			"shortEffect": "Annule tous les effets de la météo, mais n'empêche pas la météo elle-même."
		}
	],
