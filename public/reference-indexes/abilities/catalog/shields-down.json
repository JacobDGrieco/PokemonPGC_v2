	"generation": 7,
	"isMainSeries": true,
	"effectEntries": [
		{
			"language": "en",
			"effect": "When this Pokémon enters battle and at the end of each turn, if its HP is 50% or above, it changes into Meteor Form; otherwise, it changes into Core Form. In Meteor Form, it cannot be given a major status ailment (though existing ones are not cured), cannot become drowsy from Yawn, and cannot use Rest (which will simply fail). This ability cannot be copied, replaced, or nullified. This ability only takes effect for Minior.",
			"shortEffect": "Transforms this Minior between Core Form and Meteor Form. Prevents major status ailments and drowsiness while in Meteor Form."
		},
		{
			"language": "fr",
			"effect": "Quand ce Pokémon entre au combat et à la fin de chaque tour, si ses PV sont à 50% ou au-dessus, il se change en Forme Météore; sinon il se change en Forme Noyau. En Forme Météore, il ne peut pas recevoir d'altération majeure de statut (bien que les existantes ne sont pas soignées), ne peut pas être somnolent par Bâillement, et ne peut pas utiliser Repos (qui échouera simplement). Ce talent ne peut pas être copié, remplacé, ou annulé. Ce talent s'active seulement pour Météno.",
			"shortEffect": "Transforme ce Météno de la Forme Noyau en Forme Météore. Empêche les altérations majeures de statut et la somnolence en Forme Météore."
		}
	],
	"effectChanges": [],
	"descriptions": [
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "de",
			"text": "Fallen seine KP auf die Hälfte des Maximalwerts oder weniger, zerbricht die Panzerung des Pokémon und es wird aggressiver."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "en",
			"text": "When its HP becomes half or less, the Pokémon’s shell breaks and it becomes aggressive."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
