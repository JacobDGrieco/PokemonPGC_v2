	"descriptions": [
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "de",
			"text": "Erhöht in jeder Runde, in der es ein anderes Pokémon besiegt, seinen höchsten Statuswert."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "en",
			"text": "The Pokémon boosts its most proficient stat each time it knocks out a Pokémon."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
