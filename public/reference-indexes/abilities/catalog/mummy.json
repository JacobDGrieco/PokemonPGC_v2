	"effectEntries": [
		{
			"language": "de",
			"effect": "Wenn ein Pokémon mit dieser Fähigkeit von einer Attacke mit Kontakt getroffen wird, ändert sich die Fähigkeit des Gegners in Mumie. Variabilität ist nicht betroffen. Wenn das Pokémon von einem mit der Fähigkeit Hochmut besiegt wird, ändert sich dessen Fähigkeit ohne ihren Effekt auszulösen.",
			"shortEffect": "Ändert bei Kontakt die Fähigkeit von Angreifern in Mumie."
		},
		{
			"language": "en",
			"effect": "Whenever a contact move hits this Pokémon, the attacking Pokémon's ability changes to Mummy. Multitype is unaffected. If a Pokémon with Moxie knocks this Pokémon out, the former's ability will change without taking effect.",
			"shortEffect": "Changes attacking Pokémon's abilities to Mummy on contact."
		},
		{
			"language": "fr",
			"effect": "Quand une capacité de contact touche ce Pokémon, le talent du Pokémon attaquant change en Momie. Multi-Type n’est pas affecté. Si un Pokémon avec Impudence met ce Pokémon KO, le talent du premier changera sans prendre effet.",
			"shortEffect": "Change les talents des Pokémon attaquants en Momie en cas de contact."
		}
	],
