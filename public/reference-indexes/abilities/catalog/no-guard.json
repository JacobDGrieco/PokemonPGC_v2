	"effectEntries": [
		{
			"language": "de",
			"effect": "Attacken die gegen ein oder von einem Pokémon mit dieser Fähigkeit eingesetzt werden treffen immer. K.O.-Attacken sind davon nicht betroffen. Attacken die von der Fähigkeit beeinflusst werden können auch in Vorbereitungsrunden von Schaufler oder Fliegen treffen. Außerhalb vom Kampf: Wenn ein Pokémon mit dieser Fähigkeit an erster Stelle im Team steht, ist die Wahrscheinlichkeit einem wilden Pokémon zu begegnen doppelt so hoch wie normal.",
			"shortEffect": "Stellt sicher das Attacken die von dem oder gegen das Pokémon eingesetzt werden treffen."
		},
		{
			"language": "en",
			"effect": "Moves used by or against this Pokémon never miss. One-hit KO moves are unaffected. Moves affected by this ability can hit Pokémon during the preparation turn of moves like Dig or Fly. Overworld: If the lead Pokémon has this ability, the wild encounter rate is doubled.",
			"shortEffect": "Ensures all moves used by and against the Pokémon hit."
		},
		{
			"language": "fr",
			"effect": "Les capacités utilisées par ou contre ce Pokémon ne manquent jamais leur cible. Les capacités OHKO ne sont pas affectées. Les capacités affectées par ce talent peuvent frapper les Pokémon pendant le tour de préparation de capacités comme Tunnel ou Vol. Monde extérieur: Si le Pokémon de tête a ce talent, le taux de rencontre sauvage est doublé.",
			"shortEffect": "Assure que toutes les capacités utilisés par et contre le Pokémon touchent."
		}
	],
	"effectChanges": [
		{
			"versionGroup": "platinum",
			"effectEntries": [
				{
					"language": "de",
					"effect": "Wegen eines Glitches haben Attacken die von dieser Fähigkeit beeinflusst sind eine (100 - Genauigkeit)% Chance durch den Scanner oder Schutzschild zu treffen.",
					"shortEffect": ""
				},
				{
					"language": "en",
					"effect": "Moves used by or against this Pokémon never miss. One-hit KO moves are unaffected. Moves affected by this ability can hit Pokémon during the preparation turn of moves like Dig or Fly. Due to a glitch, moves affected by this ability have a (100 - accuracy)% chance to hit through Detect or Protect. Overworld: If the lead Pokémon has this ability, the wild encounter rate is doubled.",
					"shortEffect": ""
				},
				{
					"language": "fr",
					"effect": "À cause d'un glitch, les capacités affectées par ce talent ont (100 - accuracy)% de chance de transpercer Détection ou Abri.",
					"shortEffect": ""
				}
			]
		}
	],
