	"descriptions": [
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "de",
			"text": "Halbiert den Schaden, den es durch direkte Attacken nimmt, aber verdoppelt dafür den durch Feuer-Attacken erlittenen Schaden."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "en",
			"text": "Halves the damage taken from moves that make direct contact, but doubles that of Fire-type moves."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "es",
			"text": "Reduce a la mitad el daño provocado por los movimientos de contacto, pero duplica el infligido por los de tipo Fuego."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "es-419",
			"text": "Reduce a la mitad el daño provocado por los movimientos de contacto, pero duplica el infligido por los de tipo Fuego."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "fr",
			"text": "Divise par deux les dégâts des attaques directes subies par le Pokémon, mais double les dégâts des capacités de type Feu."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "it",
			"text": "Dimezza il danno causato dagli attacchi diretti di un nemico, ma raddoppia quello subito dalle mosse di tipo Fuoco."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "ja",
			"text": "相手から 受けた 接触する 技の ダメージを 半減するが ほのおタイプの 技の ダメージは ２倍になる。"
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "ja-hrkt",
			"text": "あいてから うけた せっしょくする わざの ダメージを はんげんするが ほのおタイプの わざの ダメージは ２ばいになる。"
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "ko",
			"text": "상대로부터 받은 접촉하는 기술의 데미지를 반감시키지만 불꽃타입 기술의 데미지는 2배가 된다."
		},
		{
			"versionGroup": "lets-go-pikachu-lets-go-eevee",
			"language": "zh-hans",
			"text": "会将对手所给予的接触类招式的伤害减半， 但火属性招式的伤害会变为２倍。"
		},
