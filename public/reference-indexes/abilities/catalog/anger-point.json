	"effectEntries": [
		{
			"language": "de",
			"effect": "Wenn ein Pokémon mit dieser Fähigkeit von einem kritischen Treffer getroffen wird, erhöht sich sein Angriff auf die höchste Stufe von 6. Die Fähigkeit löst auch aus, wenn der kritische Treffer vom Delegator abgefangen wird.",
			"shortEffect": "Erhöht den Angriff auf die höchste Stufe (6) wenn es einen kritischen Treffer erleidet."
		},
		{
			"language": "en",
			"effect": "Whenever this Pokémon receives a critical hit, its Attack rises to the maximum of 6 stages. This ability will still take effect if the critical hit is received by a Substitute.",
			"shortEffect": "Raises Attack to the maximum of six stages upon receiving a critical hit."
		},
		{
			"language": "fr",
			"effect": "Quand ce Pokémon reçoit un coup critique, son Attaque augmente au maximum de 6 niveaux. Ce talent prendra toujours effet si le coup critique est reçu par un Clonage.",
			"shortEffect": "Augmente l'Attaque au maximum des six niveaux en recevant un coup critique."
		}
	],
