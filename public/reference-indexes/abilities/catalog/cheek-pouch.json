	"effectEntries": [
		{
			"language": "de",
			"effect": "Wenn ein Pokémon mit dieser Fähigkeit eine Beere isst, stellt es 1/3 seiner maximalen KP wieder her, zusätzlich zum eigentlichen Effekt der Beere. Die Fähigkeit wirkt auch, wenn das Pokémon die Beere durch Schleuder, Käferbiss oder Pflücker erhalten hat, solange es von der Beere profitiert. Die Fähigkeit wirkt nicht, wenn die Beere mit Beerenkräfte verbraucht wird.",
			"shortEffect": "Stellt zusätzlich zum eigentlichen Effekt einer Beere zusätzliche KP wieder her."
		},
		{
			"language": "en",
			"effect": "Restores HP upon eating a Berry, in addition to the Berry's effect.",
			"shortEffect": "Restores HP upon eating a Berry, in addition to the Berry's effect."
		},
		{
			"language": "fr",
			"effect": "Ce Pokémon regagne 1/3 de ses PV max en mangeant une baie en plus des bénéfices normaux de celle-ci.",
			"shortEffect": "Restaure les PV en mangeant une Baie, en plus de l'effet de la Baie."
		}
	],
