	"effectEntries": [
		{
			"language": "de",
			"effect": "Ein Pokémon mit dieser Fähigkeit kann nicht vergiftet werden. Das schließt schwere Vergiftung mit ein. Wenn ein vergiftetes Pokémon diese Fähigkeit erhält, wird es von der Vergiftung geheilt. Das bezieht das Wiedererlangen dieser Fähigkeit nach dem Kampf mit ein.",
			"shortEffect": "Verhindert Vergiftung."
		},
		{
			"language": "en",
			"effect": "This Pokémon cannot be poisoned. This includes bad poison. If a Pokémon is poisoned and acquires this ability, its poison is healed; this includes when regaining a lost ability upon leaving battle.",
			"shortEffect": "Prevents poison."
		},
		{
			"language": "fr",
			"effect": "Ce Pokémon ne peut pas être empoisonné. Cela inclut le poison grave. Si un Pokémon est empoisonné et acquiert ce talent, le poison est soigné; également lorsqu'il regagne un talent perdu en quittant le combat.",
			"shortEffect": "Empêche le poison."
		}
	],
