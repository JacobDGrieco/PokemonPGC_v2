		},
		{
			"language": "en",
			"effect": "This Pokémon's Attack is doubled while in battle. This bonus does not count as a stat modifier. This ability functions identically to Pure Power.",
			"shortEffect": "Doubles Attack in battle."
		},
		{
			"language": "fr",
			"effect": "L'Attaque de ce Pokémon est doublée quand il est au combat. Ce bonus ne compte pas comme une modification de stat. Ce talent fonctionne de la même manière que Force Pure.",
			"shortEffect": "Double l'Attaque au combat."
		}
