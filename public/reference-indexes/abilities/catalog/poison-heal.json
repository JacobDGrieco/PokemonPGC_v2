	"effectEntries": [
		{
			"language": "de",
			"effect": "Wenn ein Pokémon mit dieser Fähigkeit vergiftet ist, erhält es anstatt Schaden zu erleiden 1/8 seiner maximalen KP nach jeder Runde. Das gilt auch für schwere Vergiftung.",
			"shortEffect": "Heilt jede Runde 1/8 der max KP wenn vergiftet."
		},
		{
			"language": "en",
			"effect": "If this Pokémon is poisoned, it will heal for 1/8 of its maximum HP after each turn rather than taking damage. This includes bad poison.",
			"shortEffect": "Heals for 1/8 max HP after each turn when poisoned in place of damage."
		},
		{
			"language": "fr",
			"effect": "Si ce Pokémon est empoisonné, il sera soigné d'1/8 de ses PV maximum après chaque tour plutôt que de subir des dégâts. Cela inclut le poison grave.",
			"shortEffect": "Soigne 1/8 des PV max après chaque tour quand empoisonné à la place de recevoir des dégâts."
		}
	],
	"effectChanges": [
		{
			"versionGroup": "black-white",
			"effectEntries": [
				{
					"language": "de",
					"effect": "Vergiftung schadet dem Pokémon außerhalb vom Kampf.",
					"shortEffect": ""
				},
				{
					"language": "en",
					"effect": "If this Pokémon is poisoned, it will heal for 1/8 of its maximum HP after each turn rather than taking damage. This includes bad poison. This ability does not prevent poison damage while outside of a battle.",
					"shortEffect": ""
				},
				{
					"language": "fr",
					"effect": "Le poison continue d'infliger des dégâts au Pokémon en dehors du combat.",
					"shortEffect": ""
				}
			]
		}
	],
